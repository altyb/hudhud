<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET permission, on purpose. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Autofill must read the signing certificate of the app asking for a login. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <activity
            android:name=".Settings"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The vault lives in its own process: the keyboard process never holds it. -->
        <activity android:name=".vault.VaultActivity" android:process=":vault" android:exported="false" android:label="@string/vault_title" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".vault.FillActivity" android:process=":vault" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".vault.SaveLoginActivity" android:process=":vault" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".vault.PasskeyActivity" android:process=":vault" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:windowSoftInputMode="adjustResize" />
        <service android:name=".vault.VaultBridgeService" android:process=":vault" android:exported="false" />
        <service android:name=".vault.HudhudAutofillService" android:process=":vault" android:exported="true"
            android:label="@string/app_name" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/vault_autofill" />
        </service>
        <service android:name=".vault.PasskeyService" android:process=":vault" android:exported="true"
            android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter><action android:name="android.service.credentials.CredentialProviderService" /></intent-filter>
            <meta-data android:name="android.credentials.provider" android:resource="@xml/vault_credentials" />
        </service>
    </application>
</manifest>
